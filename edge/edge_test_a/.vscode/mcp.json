{
    "inputs": [
        {
            "type": "promptString",
            "id": "pe-pat",
            "description": "Enter your Personal Access Token (PAT) for Puppet Enterprise",
            "password": true
        }
    ],
    "servers": {
        "PE-MCP-SERVICE": {
            "type": "http",
            "url": "https://pabloba-puppet.se.automationdemos.com/mcp",
            "headers": {
                "X-Authentication": "${input:pe-pat}"
            }
        }
    }
}