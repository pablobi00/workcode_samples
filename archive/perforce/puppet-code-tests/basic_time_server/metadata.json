{
  "name": "demo-basic_time_server",
  "version": "1.0.0",
  "author": "demo",
  "license": "Apache-2.0",
  "summary": "Basic time server role that installs chrony, MariaDB, and Apache on Rocky and AlmaLinux.",
  "source": "https://github.com/example/basic_time_server",
  "dependencies": [
    {
      "name": "puppetlabs/apache",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    },
    {
      "name": "puppetlabs/mysql",
      "version_requirement": ">= 10.0.0 < 12.0.0"
    },
    {
      "name": "puppet/chrony",
      "version_requirement": ">= 1.0.0 < 3.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": ["8", "9"]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": ["8", "9"]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ]
}
