{
  "description": "Create an OpenConfig VLAN on a network device",
  "input_method": "stdin",
  "files": [
    "edgeops/files/task_helper.rb",
    "edgeops/lib/puppet_x/puppetlabs/netconf/client.rb",
    "edgeops/lib/puppet_x/puppetlabs/netconf/session.rb",
    "edgeops/lib/puppet_x/puppetlabs/netconf/redactor.rb"
  ],
  "remote": false,
  "parameters": {
    "vlan_id": {
      "description": "VLAN identifier (1-4094)",
      "type": "Integer[1, 4094]"
    },
    "name": {
      "description": "Optional VLAN name",
      "type": "Optional[String]"
    },
    "network_instance": {
      "description": "Network instance containing the VLAN",
      "type": "String",
      "default": "default"
    }
  }
}